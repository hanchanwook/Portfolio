# Copy to application-local.properties inside backend/. This file is not loaded automatically.
spring.datasource.username=portfolio_app
spring.datasource.url=jdbc:mysql://localhost:3306/portfolio?connectionTimeZone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
spring.datasource.password=REPLACE_LOCALLY
# Use a randomly generated key of at least 32 characters. Never put it in React or Git.
portfolio.admin-key=${ADMIN_API_KEY:}
